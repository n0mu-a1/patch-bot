# ── 収集レイヤ (Vercel /api/feedback と loop の収集Agentが使う) ──
# Turso (libSQL) 接続。`turso db show <name> --url` と `turso db tokens create <name>` で取得。
TURSO_DATABASE_URL=libsql://reflex-lab-xxxx.turso.io
TURSO_AUTH_TOKEN=

# ── /api/feedback の軽い書き込み保護（任意・推奨） ──
# 設定するとフロントは Origin チェックのみ。空なら誰でもPOST可（検証段階の既定）。
FEEDBACK_ALLOW_ORIGIN=https://reflex-lab-two.vercel.app

# ── ループの分類Agent (GHA cron が使う) ──
# 空ならコメントNLPはスキップし、rating集計だけの決定論モードで動く。
ANTHROPIC_API_KEY=

# loop が使う DB 名（npm run db:schema 用）
TURSO_DB_NAME=reflex-lab

# ── 承認型 triage: Discord 通知（GHA triage cron が使う） ──
# Bot トークン（必須・Iris の Bot を流用）。Discord Developer Portal で取得。
DISCORD_BOT_TOKEN=
# 承認できるオーナーのユーザーID（このユーザーの ✅/❌ だけを承認判定に使う）
DISCORD_OWNER_ID=
# アプリ別の通知先チャンネルID。規約 = DISCORD_CHANNEL_<APP大文字・-は_>
# 例: app "kanji-drill" → DISCORD_CHANNEL_KANJI_DRILL
DISCORD_CHANNEL_HIRAGANA=
DISCORD_CHANNEL_KANJI_DRILL=
# 承認後に修正を投げる対象リポジトリ (owner/name)。規約 = TARGET_REPO_<APP>
TARGET_REPO_HIRAGANA=
TARGET_REPO_KANJI_DRILL=

# ── ボタン即時承認（api/discord-interactions.js / Vercel側 env）──
# ✅ボタン押下を Discord が叩く Interactions Endpoint の署名検証鍵。
# iris アプリの Developer Portal > General Information > Public Key。
DISCORD_PUBLIC_KEY=
# 上記エンドポイントは Vercel 上で DISCORD_OWNER_ID / GH_DISPATCH_TOKEN /
# BLOB_READ_WRITE_TOKEN も参照する（GHA 用と同じ値を Vercel にも設定する）。
