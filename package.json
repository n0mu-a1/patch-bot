{
  "name": "patch-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "patch-bot — 不具合修正ツール。自立型（フィードバック→AI自動パッチ→配信）＋承認型（画像つき報告→Discord承認→適用）を提供し、対象アプリ（hiragana 等）を直す。",
  "scripts": {
    "loop": "node loop/run.mjs --apply",
    "loop:dry": "node loop/run.mjs --dry-run --seed examples/reflex/seed-feedback.json",
    "loop:dry:live": "node loop/run.mjs --dry-run",
    "triage": "node triage/run.mjs both",
    "triage:dry": "node triage/run.mjs both --dry-run",
    "test": "node --test loop/*.test.mjs triage/*.test.mjs",
    "db:schema": "turso db shell \"$TURSO_DB_NAME\" < db/schema.sql",
    "db:migrate": "node db/migrate.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@libsql/client": "^0.17.3",
    "@vercel/blob": "^0.27.3"
  },
  "engines": {
    "node": ">=20"
  }
}
